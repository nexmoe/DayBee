{
  "name": "daybee-desktop",
  "productName": "DayBee",
  "version": "1.0.0",
  "description": "Desktop app for DayBee.",
  "author": "nexmoe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORTLESS=1 portless run --name daybee node scripts/desktop.mjs dev",
    "dev:web": "PORTLESS=1 portless run --name daybee vite",
    "generate": "node scripts/desktop.mjs generate",
    "build": "node scripts/desktop.mjs build",
    "build:web": "bun run typecheck && vite build",
    "build:mac": "node scripts/desktop.mjs build",
    "build:win": "node scripts/desktop.mjs build",
    "lint": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:release": "node --test scripts/release-artifacts.test.mjs",
    "test:go": "node scripts/desktop.mjs test",
    "test:race": "node scripts/desktop.mjs test -race",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:native": "node e2e/native.mjs",
    "test:mcp": "node e2e/mcp.mjs",
    "typecheck": "bun run lint"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daybee/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^0.542.0",
    "mygo-runtime": "0.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "mygo-cli": "0.3.4",
    "playwright": "^1.58.2",
    "portless": "0.15.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
