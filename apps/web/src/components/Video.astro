<section id="video">
  <div class="mx-auto w-full px-4 lg:px-6 xl:max-w-7xl pt-28 pb-24 sm:pt-40 sm:pb-36">
    <h2 class="font-display text-3xl tracking-tight text-balance sm:text-4xl mb-10 text-center">
      From a day of audio to notes you can read
    </h2>
    <div class="board-showcase" data-board-showcase>
      <div class="board-window">
        <div class="board-window-bar">
          <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>DayBee <span class="window-title-divider">/</span> Home</span>
          <span class="window-local">Runs locally</span>
        </div>
        <div class="board-captures">
          <img id="board-home" data-board-panel="home" src="/assets/screens/daybee-home.webp" width="1920" height="1200" alt="DayBee home timeline while recording, with a week of speech activity and English transcripts marked Me or unconfirmed, from Zoom, Google Meet, a Slack huddle, the microphone, and system audio." loading="lazy" />
          <img id="board-history" data-board-panel="history" src="/assets/screens/daybee-history.webp" width="1920" height="1200" alt="DayBee history grouped by day, with recording counts, microphone and system audio totals, and folders under /Users/alex/DayBee/recordings." loading="lazy" hidden />
          <img id="board-models" data-board-panel="models" src="/assets/screens/daybee-models.webp" width="1920" height="1200" alt="DayBee transcription settings with Qwen3 ASR 0.6B selected and FireRedASR2 AED, FireRedASR2 CTC, and SenseVoice Small listed as downloaded." loading="lazy" hidden />
        </div>
      </div>
      <div class="board-view-controls" role="group" aria-label="Choose a DayBee screenshot">
        <button type="button" data-board-view="home" aria-pressed="true" aria-controls="board-home">Home timeline</button>
        <button type="button" data-board-view="history" aria-pressed="false" aria-controls="board-history">History</button>
        <button type="button" data-board-view="models" aria-pressed="false" aria-controls="board-models">Models</button>
      </div>
    </div>
    <p class="board-caption">Recordings and transcripts are plain files on your disk. Use them with any tool you like.</p>
  </div>
</section>
<style>
  .board-showcase { padding:56px 44px 28px; border-radius:24px; background:#ebcbc5; }
  .board-window { width:100%; max-width:1060px; margin-inline:auto; overflow:hidden; border-radius:12px; background:#fff; border:1px solid #ffffffa6; box-shadow:0 24px 64px #30234120,0 4px 12px #3023410d; }
  .board-window-bar { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:12px; height:42px; padding:0 16px; background:#faf9fc; border-bottom:1px solid #eae8ee; color:#61596b; font-size:11px; }
  .window-controls { display:flex; gap:6px; }
  .window-controls i { display:block; width:9px; height:9px; border-radius:50%; background:#d0cbd7; }
  .window-controls i:first-child { background:#e5aaa5; } .window-controls i:nth-child(2) { background:#e3c48c; } .window-controls i:last-child { background:#9ec8ae; }
  .window-title-divider { padding:0 7px; color:#b9b2c2; }
  .window-local { justify-self:end; color:#a39aaa; font-size:10px; }
  .board-captures { aspect-ratio:16/10; background:#faf9fc; }
  .board-captures img { display:block; width:100%; height:100%; object-fit:contain; }
  .board-view-controls { display:flex; justify-content:center; flex-wrap:wrap; gap:5px; margin-top:24px; }
  .board-view-controls button { padding:8px 16px; border-radius:30px; font:inherit; font-size:12px; color:#706578; cursor:pointer; transition:background-color .2s,color .2s; }
  .board-view-controls button[aria-pressed="true"] { background:#ffffffb8; color:#30273b; }
  .board-view-controls button:hover { background:#ffffff80; color:#30273b; }
  .board-view-controls button:focus-visible { outline:2px solid #756184; outline-offset:3px; }
  .board-caption { margin-top:18px; text-align:center; color:var(--color-theme-text-muted); font-size:12px; }
  @media(max-width:639px) {
    .board-showcase { padding:22px 12px 16px; border-radius:20px; }
    .board-window { border-radius:8px; }
    .board-window-bar { height:32px; padding:0 9px; gap:6px; font-size:10px; }
    .window-controls { gap:4px; } .window-controls i { width:6px; height:6px; }
    .window-local { font-size:8px; }
    .board-view-controls { margin-top:16px; }
    .board-view-controls button { padding:7px 12px; font-size:11px; }
    .board-caption { padding:0 14px; line-height:1.6; }
  }
  @media(prefers-reduced-motion:reduce) { .board-view-controls button { transition:none; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-board-showcase]').forEach(showcase => {
    const buttons = showcase.querySelectorAll<HTMLButtonElement>('[data-board-view]');
    const panels = showcase.querySelectorAll<HTMLImageElement>('[data-board-panel]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const selected = button.dataset.boardView;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      panels.forEach(panel => { panel.hidden = panel.dataset.boardPanel !== selected; });
    }));
  });
</script>
